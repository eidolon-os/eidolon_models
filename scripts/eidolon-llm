#!/bin/sh
# Start this Host's own chat model, or say why it cannot.
#
# A launcher rather than the server itself, for the reason the LiveKit unit has
# one: `llama-server` is a third-party binary and the arguments it needs are
# this Host's facts — which cores it may use, which port it was given, where its
# weights were carried. None of those belong baked into a unit file, and none of
# them can be read by a binary we do not build.
#
# What this does not do: choose. Every value below is decided somewhere that
# owns it — the core allocation in /etc/eidolon/cpu-allocation.env (the board's
# single tuning point), the port in the component's ops contract, the weights by
# the artifact Ops carried. This only assembles them and hands over.
set -eu

MODEL=${EIDOLON_LLM_MODEL:-}
PORT=${EIDOLON_LLM_PORT:-}
HOST=${EIDOLON_LLM_HOST:-127.0.0.1}
CONTEXT=${EIDOLON_LLM_CONTEXT_SIZE:-2048}
SERVER=${EIDOLON_LLM_SERVER:-/usr/local/bin/llama-server}

if [ -z "$MODEL" ] || [ -z "$PORT" ]; then
  echo "eidolon-llm: EIDOLON_LLM_MODEL and EIDOLON_LLM_PORT are required" >&2
  exit 2
fi
if [ ! -f "$MODEL" ]; then
  # The weights are carried by Ops against a recorded digest, not fetched here:
  # this Host may have no route to a model hub, and a service that downloaded
  # on first use would answer its first turn minutes late or not at all.
  echo "eidolon-llm: model weights are absent: $MODEL" >&2
  echo "eidolon-llm: they are carried by Ops for a Host declaring local_llm" >&2
  exit 2
fi
if [ ! -x "$SERVER" ]; then
  echo "eidolon-llm: $SERVER is absent; it is a pinned foundation artifact" >&2
  exit 2
fi

set -- "$SERVER" \
  --model "$MODEL" \
  --host "$HOST" \
  --port "$PORT" \
  --ctx-size "$CONTEXT" \
  --jinja \
  --reasoning off

# Qwen3 emits reasoning by default, and `--reasoning off` above is what turns it
# off. Without any such flag the model spends the whole completion budget inside
# its own thinking and returns an **empty string rather than an error** — which
# reads as a broken model rather than a configuration choice.
#
# `off` and not `--reasoning-budget 0`, which is what this used to pass. The
# budget flag is the wrong instrument: it lets the template *start* thinking and
# then cuts it off, so every reply came back beginning with a stray closing tag
#
#     "</think>\n\n欢迎体验达摩院..."
#
# — measured on the board, 4 out of 4. Downstream that is not cosmetic: the
# local TTS refuses text containing a line break (its engine reads one utterance
# per line), so a Host with both local models could not speak its own replies,
# and anything that did would say the tag out loud. `--reasoning off` tells the
# template not to enable thinking at all, so there is nothing to close.
#
# Checked against the failure the budget flag was there to prevent: five prompts
# built to provoke thinking — arithmetic, a multi-step word problem, and one
# that says "think carefully first" — all answered non-empty, tag-free and on a
# single line. It also got 27 x 43 right.
#
# Disabled here, on the Host, so no client has to learn a second way of asking
# for it: the one Eidolon already has is DeepSeek's `extra_body`, which
# llama.cpp does not read.

# Cores. Two masks, because prefill and decode want different ones and
# llama.cpp is the only layer that can tell them apart: `taskset` confines the
# whole process, which is why this used to hand decode's four A55 cores to
# prefill as well and take 13.8 s to read a production-sized prompt.
#
#   decode  -- A55 0-3. It runs while the local TTS is speaking the sentence
#              before it, and synthesis has only 15% of realtime to spare, so
#              the two must not share a cluster. Measured: 5.2 tok/s here
#              against 17.5 on the A76 cluster, and the fast one costs an
#              audible gap.
#   prefill -- all eight. It runs before there is any text to speak, so the
#              A76 cores are idle at that moment: 20.2 -> 86.2 tok/s, which is
#              a production first token at 3.2 s instead of 13.8. The overlap
#              that does exist (a barge-in, while the previous reply is still
#              playing) was measured and holds +272 ms of buffer.
#
# See HOST-RK3588.md 2.29 and deploy/cpu-allocation.env, which decides both.
#
# The thread count is derived, not configured. `--cpu-mask` alone leaves
# llama.cpp sizing its pool from the machine's core count, so four cores got
# eight threads and decode collapsed to 1.36 tok/s -- slower than any mask this
# is meant to choose between. A count without a mask is equally wrong, so
# neither is separable and neither is optional.
cpu_mask() {
  # A taskset-style list -- `4`, `4,5`, `0-3`, `0-3,7` -- as the lowercase hex
  # llama.cpp wants. Held against the Python parser every service uses by
  # tests/test_cpu_allocation.py.
  awk -v spec="$1" '
    BEGIN {
      n = split(spec, parts, ",")
      for (i = 1; i <= n; i++) {
        chunk = parts[i]
        gsub(/^[ \t]+|[ \t]+$/, "", chunk)
        if (chunk == "") continue
        if (index(chunk, "-") > 0) {
          split(chunk, ends, "-")
          lo = ends[1] + 0; hi = ends[2] + 0
          if (lo > hi) { print "range"; exit 1 }
          for (c = lo; c <= hi; c++) seen[c] = 1
        } else {
          seen[chunk + 0] = 1
        }
      }
      count = 0
      for (c in seen) { count++; if (c + 0 > top) top = c + 0 }
      if (count == 0) { print "empty"; exit 1 }
      # Hex by hand: awk has no arbitrary-width integers and cpu 63 would
      # overflow a double, so build the digits from the highest nibble down.
      digits = "0123456789abcdef"
      out = ""
      for (nib = int(top / 4); nib >= 0; nib--) {
        v = 0
        for (b = 0; b < 4; b++) if (seen[nib * 4 + b]) v += 2 ^ b
        out = out substr(digits, v + 1, 1)
      }
      sub(/^0+/, "", out)
      if (out == "") out = "0"
      printf "%s %d\n", out, count
      exit 0
    }'
}

apply_mask() {
  # $1 = the list, $2/$3 = the flags for the mask and the thread count.
  spec=$1; mask_flag=$2; threads_flag=$3
  parsed=$(cpu_mask "$spec") || {
    echo "eidolon-llm: cannot read a CPU list from '$spec'" >&2
    exit 2
  }
  set -- "$@" "$mask_flag" "${parsed% *}" "$threads_flag" "${parsed#* }"
  shift 3
  MASK_ARGS="$*"
}

DECODE_CPUS=${EIDOLON_LLM_CPU_AFFINITY:-}
PREFILL_CPUS=${EIDOLON_LLM_PREFILL_CPU_AFFINITY:-}

if [ -n "$DECODE_CPUS" ]; then
  apply_mask "$DECODE_CPUS" --cpu-mask --threads
  # Strict, so the kernel does not migrate a decode thread onto a core this
  # Host gave to something else -- which is the whole point of the mask.
  set -- "$@" $MASK_ARGS --cpu-strict 1
fi
if [ -n "$PREFILL_CPUS" ]; then
  apply_mask "$PREFILL_CPUS" --cpu-mask-batch --threads-batch
  set -- "$@" $MASK_ARGS
fi
# An explicit count is still allowed, and now means what it says: override the
# one derived from the decode mask. Kept for probing a single variable.
if [ -n "${EIDOLON_LLM_THREADS:-}" ]; then
  set -- "$@" --threads "$EIDOLON_LLM_THREADS"
fi

exec "$@"
