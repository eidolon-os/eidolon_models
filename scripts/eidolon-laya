#!/bin/sh
set -eu
REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Host capabilities come from Ops' sealed host.env. Explicit backend wins;
# a failed NPU never silently changes execution to CPU.
case ",${EIDOLON_HOST_CAPABILITIES:-}," in
  *,rknpu2,*) DEFAULT_BACKEND=rknn ;;
  *) DEFAULT_BACKEND=onnx ;;
esac
export EIDOLON_LAYA_BACKEND=${EIDOLON_LAYA_BACKEND:-$DEFAULT_BACKEND}
case "$EIDOLON_LAYA_BACKEND" in
  rknn)
    MODEL_DIR=${EIDOLON_LAYA_MODEL_DIR:-/var/lib/eidolon/models/laya-smart-home-r14-rknn-45f3dedb}
    REQUIRED_FILE=npu/hidden_l512.rknn
    export EIDOLON_LAYA_RKNN_LIBRARY=${EIDOLON_LAYA_RKNN_LIBRARY:-$MODEL_DIR/librknnrt.so}
    ;;
  onnx)
    MODEL_DIR=${EIDOLON_LAYA_MODEL_DIR:-/var/lib/eidolon/models/laya-smart-home-r14-onnx-45f3dedb}
    REQUIRED_FILE=onnx/model.onnx.data
    ;;
  *) echo "eidolon-laya: unsupported release backend: $EIDOLON_LAYA_BACKEND" >&2; exit 2 ;;
esac
if [ ! -f "$MODEL_DIR/manifest.json" ] || [ ! -f "$MODEL_DIR/$REQUIRED_FILE" ]; then
  echo "eidolon-laya: pinned model artifact missing: $MODEL_DIR" >&2
  exit 2
fi
export EIDOLON_LAYA_MODEL_DIR="$MODEL_DIR"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
exec "$REPO_ROOT/.venv/bin/eidolon-laya" "$@"
