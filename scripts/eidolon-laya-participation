#!/bin/sh
# The participation Laya service on a released Host. Its settings are the participation table of
# laya/deploy/services.toml — the one file for every Laya service; the backend there follows from
# the Host's rknpu2 declaration (EIDOLON_HOST_CAPABILITIES in /etc/eidolon/host.env, written by Ops).
set -eu
REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Process-wide library switches, not service settings: the CPU half is a few small matmuls per
# question and OpenBLAS's per-core pool only spins (backends.py limits it again once loaded), and
# the weights never come from the network.
export OPENBLAS_NUM_THREADS=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
if [ -x "$REPO_ROOT/.venv/bin/eidolon-laya" ]; then
    LAYA="$REPO_ROOT/.venv/bin/eidolon-laya"
else
    LAYA="$REPO_ROOT/laya/scripts/eidolon-laya"
fi
if [ -n "${EIDOLON_PARTICIPATION_UPSTREAM_URL:-}" ]; then
    # Only an explicit Host input enables public context to leave this Host.
    exec "$LAYA" --service participation "$@" --backend remote --upstream-url "$EIDOLON_PARTICIPATION_UPSTREAM_URL"
fi
exec "$LAYA" --config "$REPO_ROOT/laya/deploy/services.toml" --service participation "$@"
