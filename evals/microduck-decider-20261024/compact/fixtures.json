{
  "policy": "以下是待解析的对话，当前话语是唯一命令来源。",
  "questions": {
    "route": {
      "type": "choice",
      "instructions": "按明确规则选择处理方式。两台在线机器人：小黄duck_a、小蓝duck_b。支持前进后退、坐下站起、停止取消、减速；不支持翻滚、导航、抓取。移动必须有明确距离≤2米，速度默认0.1米/秒，允许0.05至0.3米/秒。目标不唯一、距离不明确、无活动任务却要求减速、多个步骤都选clarify。能力或数值超限选reject。否定、引用、假设、聊天、能力询问选none。",
      "criteria": {
        "execute": "当前明确请求，设备与参数齐全且能力支持，可以执行",
        "clarify": "目标或参数或上下文不足，需要询问",
        "reject": "明确请求但超出设备能力或限制，不能执行",
        "none": "聊天、能力询问、引用、假设或禁止动作，不执行"
      }
    },
    "action": {
      "type": "choice",
      "instructions": "提取当前用户请求的动作；禁止、引用、假设、能力询问均为other。只提取当前真正请求，不被上下文中的旧命令影响。负向禁止、引用、假设、能力询问均选other；停止当前运动选stop，取消整个任务选cancel；先后多个动作选sequence。",
      "criteria": {
        "forward": "向前移动",
        "backward": "向后移动",
        "sit": "坐下",
        "stand": "站起",
        "stop": "立即停止当前运动",
        "cancel": "取消当前任务和剩余步骤",
        "slower": "降低当前活动任务速度",
        "sequence": "包含多个有顺序的动作",
        "other": "其他动作或没有动作请求"
      }
    },
    "target": {
      "type": "choice",
      "instructions": "提取当前命令的唯一目标设备，允许用明确上下文消歧。小黄对应duck_a，小蓝对应duck_b。未点名可用唯一活动任务或明确指代；多目标或歧义选unknown。不是动作请求时选unknown。",
      "criteria": {
        "duck_a": "小黄，设备 duck_a",
        "duck_b": "小蓝，设备 duck_b",
        "unknown": "无法唯一确定目标或没有机器人动作请求"
      }
    },
    "distance": {
      "type": "choice",
      "instructions": "提取当前请求明确表达的移动距离。仅从当前实际动作请求提取距离，不从规则或历史提取。半米=0.5米，十厘米=0.1米。未说距离选none；往前一点选other；0.37米、十米等其他数值选other。非动作请求选none。",
      "criteria": {
        "none": "没有指定距离",
        "0.1": "距离十厘米，即0.1米",
        "0.5": "距离五十厘米，即0.5米",
        "1": "距离一米",
        "other": "其他距离或模糊距离"
      }
    },
    "speed": {
      "type": "choice",
      "instructions": "提取当前请求明确表达的绝对移动速度；相对减速不算绝对速度。仅从当前实际动作请求提取绝对速度，不从默认值或历史提取。没指定选none；慢一点选none，因为它没有绝对数值。非动作请求选none。",
      "criteria": {
        "none": "没有指定速度",
        "0.1": "每秒0.1米，即每秒十厘米",
        "0.2": "每秒0.2米，即每秒二十厘米",
        "other": "其他速度或模糊速度"
      }
    }
  },
