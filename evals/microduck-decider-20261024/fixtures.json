{
  "policy": "你是机器人语音命令解析器。仅判断当前用户话语，历史只用于明确指代，不执行引用或假设内容。\n虚拟设备：小黄=duck_a，小蓝=duck_b，均在线。均支持前进、后退、坐下、站起、停止、取消任务、减速，支持距离闭环。速度范围0.05至0.3米/秒，距离0至2米。无导航、视觉找物、抓取、翻跟头能力。本实验是虚拟能力，不代表Microduck真实能力。\n没点名且没有唯一上下文目标时询问。移动没说距离时询问；不指定速度使用默认0.1米/秒。“慢一点”仅当存在活动移动任务且目标明确时可执行。停止是停止当前运动；取消是取消当前任务及剩余步骤。复合任务一律交规划器，本次route=clarify、action=sequence，不执行部分步骤。能力询问不视为动作请求。\n非动作请求route=none时，action=other,target=unknown,distance=none,speed=none。拒绝或询问时仍提取明确动作、目标、参数。",
  "questions": {
    "route": {
      "type": "choice",
      "instructions": "按明确规则选择处理方式。",
      "criteria": {
        "execute": "当前明确请求，设备与参数齐全且能力支持，可以执行",
        "clarify": "目标或参数或上下文不足，需要询问",
        "reject": "明确请求但超出设备能力或限制，不能执行",
        "none": "聊天、能力询问、引用、假设或禁止动作，不执行"
      }
    },
    "action": {
      "type": "choice",
      "instructions": "提取当前用户请求的动作；禁止、引用、假设、能力询问均为other。",
      "criteria": {
        "forward": "向前移动",
        "backward": "向后移动",
        "sit": "坐下",
        "stand": "站起",
        "stop": "立即停止当前运动",
        "cancel": "取消当前任务和剩余步骤",
        "slower": "降低当前活动任务速度",
        "sequence": "包含多个有顺序的动作",
        "other": "其他动作或没有动作请求"
      }
    },
    "target": {
      "type": "choice",
      "instructions": "提取当前命令的唯一目标设备，允许用明确上下文消歧。",
      "criteria": {
        "duck_a": "小黄，设备 duck_a",
        "duck_b": "小蓝，设备 duck_b",
        "unknown": "无法唯一确定目标或没有机器人动作请求"
      }
    },
    "distance": {
      "type": "choice",
      "instructions": "提取当前请求明确表达的移动距离。",
      "criteria": {
        "none": "没有指定距离",
        "0.1": "距离十厘米，即0.1米",
        "0.5": "距离五十厘米，即0.5米",
        "1": "距离一米",
        "other": "其他距离或模糊距离"
      }
    },
    "speed": {
      "type": "choice",
      "instructions": "提取当前请求明确表达的绝对移动速度；相对减速不算绝对速度。",
      "criteria": {
        "none": "没有指定速度",
        "0.1": "每秒0.1米，即每秒十厘米",
        "0.2": "每秒0.2米，即每秒二十厘米",
        "other": "其他速度或模糊速度"
      }
    }
  },
