# Copy to laya/.env (gitignored) for local runs; on a server the same keys go in
# /etc/eidolon-laya/eidolon-laya.env (see deploy/). Every key is optional.

# torch | onnx  (onnx needs `eidolon-laya export-onnx` once)
EIDOLON_LAYA_BACKEND=torch
# torch only: auto | cpu | mps | cuda
EIDOLON_LAYA_DEVICE=auto
# intra-op threads, 0 = runtime default. On a 1-core/2-thread VM, 1 is fastest.
EIDOLON_LAYA_THREADS=0

EIDOLON_LAYA_HOST=127.0.0.1
EIDOLON_LAYA_PORT=8771
# Required when HOST is not loopback. Generate: openssl rand -hex 24
EIDOLON_LAYA_API_KEY=

# Token budget per question; empty = the checkpoint's trained 1024.
EIDOLON_LAYA_MAX_LEN=
# Budget for instruction + options; empty = the checkpoint's (256 for laya-multilingual).
# Raise it when a question has many options (e.g. a long device list).
EIDOLON_LAYA_HEAD_MAX_LEN=
EIDOLON_LAYA_MAX_PENDING=4
EIDOLON_LAYA_MAX_QUESTIONS=32

# Only for `fetch`: e.g. https://hf-mirror.com where huggingface.co is unreachable.
HF_ENDPOINT=
