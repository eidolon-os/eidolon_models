[Unit]
Description=Eidolon laya decision API (POST /v1/systemone)
Documentation=file:///opt/eidolon-laya/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eidolon-laya
Group=eidolon-laya
# Backend, port, threads and the API key live here (written by deploy/ecs/deploy.sh).
EnvironmentFile=/etc/eidolon-laya/eidolon-laya.env
Environment=EIDOLON_LAYA_HOME=/opt/eidolon-laya
Environment=HF_HOME=/var/lib/eidolon-laya/hf
StateDirectory=eidolon-laya
ExecStart=/opt/eidolon-laya/scripts/eidolon-laya serve
Restart=on-failure
RestartSec=3
# The host is small and shared: one request with a huge max_len must not take it down.
MemoryMax=4G
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
