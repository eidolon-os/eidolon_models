[Unit]
Description=Eidolon laya decision API (POST /v1/systemone)
Documentation=file:///opt/eidolon-laya/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eidolon-laya
Group=eidolon-laya
# Backend, listen address, threads and the key file are this server's services file, written once by
# deploy/ecs/deploy.sh (the format of laya/deploy/services.toml, with one [systemone] table).
Environment=HF_HOME=/var/lib/eidolon-laya/hf
StateDirectory=eidolon-laya
ExecStart=/opt/eidolon-laya/scripts/eidolon-laya --config /etc/eidolon-laya/services.toml --service systemone serve
Restart=on-failure
RestartSec=3
# The host is small and shared: one request with a huge max_len must not take it down.
MemoryMax=4G
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
