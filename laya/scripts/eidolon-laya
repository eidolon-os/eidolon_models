#!/bin/sh
# Launcher for the laya decision service, the same on a laptop and on a server.
#
#   scripts/eidolon-laya doctor | fetch | export-onnx | serve | predict ...
#   scripts/eidolon-laya test [pytest args]
#
# Service settings are laya/deploy/services.toml (--service picks the table); nothing is
# read from the environment for them.
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LAYA_HOME=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
# Offline at runtime: weights come from models/, never from the network.
HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}
case "${1:-}" in fetch) HF_HUB_OFFLINE=0; TRANSFORMERS_OFFLINE=0 ;; esac
export HF_HUB_OFFLINE TRANSFORMERS_OFFLINE

VENV_BIN=${EIDOLON_LAYA_VENV_BIN:-$LAYA_HOME/.venv/bin}
UV_BIN=${EIDOLON_LAYA_UV_BIN:-uv}

if [ "${1:-}" = "test" ]; then
  shift
  if [ -x "$VENV_BIN/pytest" ]; then
    exec "$VENV_BIN/pytest" --rootdir "$LAYA_HOME" "$LAYA_HOME/tests" "$@"
  fi
  exec "$UV_BIN" run --project "$LAYA_HOME" --all-extras --group dev pytest "$LAYA_HOME/tests" "$@"
fi

if [ -x "$VENV_BIN/eidolon-laya" ]; then
  exec "$VENV_BIN/eidolon-laya" "$@"
fi
exec "$UV_BIN" run --project "$LAYA_HOME" --all-extras eidolon-laya "$@"
