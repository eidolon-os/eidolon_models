* text=auto

# Model weights and runtime artifacts
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text
*.rknn filter=lfs diff=lfs merge=lfs -text
*.rkllm filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text
*.plan filter=lfs diff=lfs merge=lfs -text
*.mlmodel filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
laya/deploy/rk3588/librknnrt.so filter=lfs diff=lfs merge=lfs -text

# Packaged model assets
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

# Pinned upstream model artifacts are checksum-verified and kept byte-exact.
asr/**/model/* -diff -text
# The TTS tree nests (text_frontend/, voices/, fixture/, flow/), so this
# matches at any depth rather than only the package's top level.
tts/**/model/** -diff -text

# The Laya models a Host runs are LFS objects so that any operator's checkout can release them, but
# they reach a Host as component artifacts (ops/component.toml: carried once, verified by digest),
# never inside a release archive.
laya/models/** export-ignore

# Generated tokenizer copies are byte-identical artifacts; avoid multi-million-line diffs.
laya/**/tokenizer/tokenizer.json -diff -text
