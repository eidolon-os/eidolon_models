# RK3588 核分配 —— 全板唯一可调点
#
# 装到 /etc/eidolon/cpu-allocation.env，systemd unit 以 EnvironmentFile= 读取；
# 手工跑基准时 `set -a; . deploy/cpu-allocation.env; set +a` 同样生效。
# 改完 systemd 侧需要 `systemctl restart eidolon-asr`（不需要 daemon-reload，
# EnvironmentFile 每次启动都重读）。
#
# 板子布局：cpu0-3 = A55 @1.8GHz，cpu4-7 = A76 @2.256GHz。
# 语法同 taskset：`4,5`、`0-3`、`4-7`、`0-3,7`。留空 = 不绑核。
#
# 线程数会自动跟随：intra_op 池按 os.process_cpu_count() 取数并夹到 4，
# 所以**只需要改这里的核，不要再单独设线程数**。手工覆盖用
# EIDOLON_ASR_THREADS，但那会解除联动，仅供排查。


# ---------------------------------------------------------------------------
# ASR (funasr 2pass, ONNX CPU) —— 本仓唯一已接线的服务
# ---------------------------------------------------------------------------
# 留空是现行方案：不绑核，靠内核 EAS 把 offline 突发放上大核。
# 依据：绑 A55 的 eot_final 1271 ms vs 不绑核 292 ms（HOST-RK3588.md §2.16）。
EIDOLON_ASR_CPU_AFFINITY=

# 实测备选（2026-09-05，单路、realtime-paced、asr_example_zh.wav，total_rtf p50）：
#
#   不绑核        threads=4   0.226 / 0.255   ← 当前
#   4-7 (A76x4)   threads=4   0.251 / 0.255
#   4,5 (A76x2)   threads=2   0.281           ← 只用一半大核，代价很小
#   0-3 (A55x4)   threads=4   0.691 / 0.671
#
# `4,5` 是给 LLM/TTS 腾大核时的候选：比 A76x4 只慢 ~11%，省下 2 个大核。
# 但它与「不绑核」孰优尚未在**混跑**下比过。改这一行之前先重跑证据：
#
#   scripts/asr-affinity-sweep -r 5 -n "LLM+TTS 并发中" - 4,5
#
# 它会打出可直接粘进 HOST-RK3588.md 的表格。空载下已知不绑核更快
# （0.225 vs 0.280），悬而未决的正是混跑——见 VERIFICATION.md §6。
#
# 决定（2026-09-06 更新）：**维持不绑核 —— 但理由从「数据不足」变成「实测更差」。**
# 在 ASR 流式常驻的条件下实测三种配置（HOST-RK3588.md §2.17 的 T8 补充）：
# 钉在 `4,5` 是三者中最差的（LLM @512 6.65 tok/s、TTS rtf 1.312），
# 而 ASR 放 A55 是 9.71 / 1.256。原因不需要部署也能看清：
# **RKLLM 默认就占 A76 4-7**，把 ASR 钉到 4,5 等于和它正面重叠，
# 而不绑核时内核至少还能把它挪开。上面「省下 2 个大核」的设想不成立：
# 没有谁缺大核，缺的是不要去撞 RKLLM。
#
# governor（2026-09-06 已定）：**出厂用 performance。**
# ondemand 的代价实测：ASR 19-22%（大核），**LLM decode 32%**——后者是
# 跑在 NPU 上的负载，因为 decode 让 CPU 太闲、governor 不升频，但 RKLLM
# 的宿主线程照样吃低频的亏（HOST-RK3588.md §2.19）。散热顾虑不成立：
# 这块板有风扇，满负载 decode 时 47°C、风扇 pwm=0 尚未转动。
# **核配置的排序不受 governor 影响**（§2.16 ④）。
#
# 机制不是写一行文件：本板上 /etc/default/cpufrequtils 里 ENABLE=false，
# 真正生效的是 armbian-hardware-optimization —— 它 source 该文件只取变量、
# 无视 ENABLE，然后写进每个 policy 的 scaling_governor。所以设 GOVERNOR=
# performance 并 `systemctl restart armbian-hardware-optimize` 才生效。
# 这条已写进 eidolon_ops 的 RK3588 foundation profile（cpu_governor 字段）。
# scripts/host-probe 会报告当前 governor。


# ---------------------------------------------------------------------------
# LLM (Qwen3-1.7B Q4_0 / llama.cpp) —— 已接线
# ---------------------------------------------------------------------------
# **A55 0-3，四线程。** 这不是调优，是分配方案的一半：把聊天 LLM 整个搬出 NPU，
# TTS 才能独占 NPU 并且不断音（HOST-RK3588.md §2.23）。
#
# 上面那条早先的注释说「LLM 不要设 CPU mask，RKLLM 自选 A76 4-7 即最优」——
# 那是 NPU 方案下的结论，§2.22 已经推翻它：两者都在 NPU 上时不能同轮流式共存，
# 缺口 2.8-4.6 倍。llama.cpp 在 CPU 上跑这个模型反而更快，于是 NPU 整个让给 TTS。
#
# 实测（A55 0-3、四线程、其余服务都在跑）：decode 5.83-5.88 tok/s、prefill 19.8。
# 门槛是「LLM 供得上 TTS 说」= 3.43 tok/s（121 字 = 79 token / 23 s 音频），
# 所以余量 1.7 倍。放 A76 4-7 能到 18.94，但会打断 TTS —— 不要那么做。
EIDOLON_LLM_CPU_AFFINITY=0-3

# 线程数跟着核走。留空则由 llama-server 自己决定，在这块板上会取满 8 核并因此
# 跨簇调度，实测更差。
EIDOLON_LLM_THREADS=4


# ---------------------------------------------------------------------------
# 以下服务不在本仓 —— 占位，等它们落地时接同样的机制
# ---------------------------------------------------------------------------

# TTS CosyVoice2：实测绑 A76 4-6 时 rtf 0.926；给到 4-7 反而是 1.015。
# NPU 侧 RKNN 有 rknn_set_core_mask，可按 RKNN_NPU_CORE_0/1/2 钉核。
#EIDOLON_TTS_CPU_AFFINITY=4-6

# memory bge：绑 A76、线程数=核数；A76x2 (seq 44 约 8.5 ms/doc) 就够用，
# 不必占满 4 个大核。切忌放 A55 或让 ORT 用满 8 核（慢线程拖累整批）。
#EIDOLON_MEMORY_CPU_AFFINITY=6,7
