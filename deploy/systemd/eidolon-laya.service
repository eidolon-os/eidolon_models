[Unit]
Description=Eidolon local Laya decision suggestions
After=local-fs.target network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
# EIDOLON_HOST_CAPABILITIES: rknpu2 picks the NPU backend. Every other setting is laya/deploy/services.toml.
EnvironmentFile=/etc/eidolon/host.env
Environment=PATH=/opt/eidolon/current/eidolon_models/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/eidolon/current/eidolon_models/scripts/eidolon-laya serve
Restart=on-failure
RestartSec=2
TimeoutStartSec=180
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
